.screen {
    width: 100%;
    height: 100%;
    flex-grow: 1;
}

.score {
    position: absolute;
    top: 20px;
    left: 20px;

    font-size: 32px;
    color: white;
}

.start-message {
    position: absolute;
    width: 100%;
    top: 45%;

    font-size: 32px;
    color: white;

    -unity-text-align: middle-center;
}

.game-over {
    display: none;

    position: absolute;
    width: 100%;
    height: 100%;

    left: 0;
    top: 0;

    align-items: center;
    justify-content: center;
}

.game-over-title {
    font-size: 48px;
    color: white;

    -unity-font-style: bold;
    -unity-text-align: middle-center;

    margin-bottom: 20px;
}

.final-score {
    font-size: 32px;
    color: white;

    -unity-text-align: middle-center;
}